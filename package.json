{
  "name": "python-interpreter-explainer-bn",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A Bangla educational motion-graphics film explaining the Python interpreter pipeline.",
  "scripts": {
    "timeline": "node scripts/run-python.mjs scripts/build_timeline.py",
    "prepare": "node scripts/prepare.mjs",
    "audio": "node scripts/run-python.mjs scripts/build_audio.py",
    "render": "node render.mjs --out out/video_silent.mp4",
    "mux": "node scripts/mux.mjs",
    "build": "npm run timeline && npm run prepare && npm run audio && npm run render && npm run mux",
    "stills": "node render.mjs --stills 4,14,29,40,53,67,77,87,96,101",
    "test": "node scripts/validate.mjs",
    "preview": "node scripts/preview.mjs"
  },
  "dependencies": {
    "@sparticuz/chromium": "^153.0.0",
    "puppeteer-core": "^25.17.0"
  }
}
