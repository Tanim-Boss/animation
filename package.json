{
  "name": "twos-complement-motion",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A cinematic motion-graphics explainer on two's complement, built with Remotion.",
  "scripts": {
    "studio": "node scripts/studio.mjs",
    "prepare:browser": "node scripts/prepare-browser.mjs",
    "audio": "node scripts/run-python.mjs scripts/build_audio.py",
    "stills": "node scripts/stills.mjs",
    "render": "node scripts/render.mjs",
    "build": "npm run setup && npm run audio && npm run render",
    "typecheck": "tsc --noEmit",
    "setup": "node scripts/prepare-browser.mjs && node scripts/make-grain.mjs"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.544",
    "@remotion/cli": "4.0.544",
    "@remotion/renderer": "4.0.544",
    "@sparticuz/chromium": "153.0.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "remotion": "4.0.544"
  },
  "devDependencies": {
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "typescript": "5.7.3"
  }
}
